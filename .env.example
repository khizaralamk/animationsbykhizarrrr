# Settings for the website. Add them in Vercel > this site > Settings > Environment Variables
# (type "Config", not "Secret"), then redeploy. Everything here is public by design: these values
# are built into the pages. No secret key ever goes in this site.

# The address of the backend (the oled-backend project), no slash at the end.
VITE_API_URL=

# Paddle checkout (only needed when you sell something).
# A "client-side token" from Paddle > Developer tools > Authentication. It is meant to be public.
VITE_PADDLE_CLIENT_TOKEN=
# "sandbox" while testing, "production" for real payments.
VITE_PADDLE_ENV=production

# Paddle price ids, one per paid animation (they start with pri_). Sandbox ids on your PC, live ids on Vercel.
VITE_PRICE_PRISON_REALM=
VITE_PRICE_PRISON_REALM_LAUNCH=
VITE_PRICE_SURVEY_CORPS=
VITE_PRICE_SURVEY_CORPS_LAUNCH=
