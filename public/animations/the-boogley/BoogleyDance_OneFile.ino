// BOOGLEY DANCE (everything in one file) for an ESP32 + 0.96" OLED (128 x 64, I2C)
// Wiring: OLED VCC -> 3V3, GND -> GND, SDA -> G25, SCL -> G26
//
// Plays the 151 frame dance from the-boogley.html in a loop.
// Each frame is a ready made 128 x 64 picture stored at the bottom of this file,
// so the board only has to copy a picture to the screen ten times a second.
// Needs the Adafruit SSD1306 and Adafruit GFX libraries (Library Manager).

#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
// All the frames are at the very bottom of this file (about 155 KB).
// These lines tell the compiler about them before they are used.
const int BOOGLEY_COUNT = 151;
const int BOOGLEY_FRAME_BYTES = 1024;
extern const uint8_t BOOGLEY_FRAMES[154624];

const int SDA_PIN = 25;
const int SCL_PIN = 26;

const int SCREEN_W = 128;
const int SCREEN_H = 64;

// ----- settings you can change -----
const int FRAMES_PER_SECOND = 10;  // 10 = the speed of the video. 20 = twice as fast
const bool BOUNCE = false;         // false = jump back to the start. true = play forward then backward
const bool MIRROR = false;         // true = flip the dancer left to right

Adafruit_SSD1306 display(SCREEN_W, SCREEN_H, &Wire, -1);
int foundAddr = 0;

int frame = 0;                     // which frame is on screen
int direction = 1;                 // +1 forward, -1 backward (only used with BOUNCE)
unsigned long lastFrameAt = 0;

// ---------------------------------------------------------------------
// Puts frame number f on the OLED.
// ---------------------------------------------------------------------
void showFrame(int f) {
  const uint8_t* pic = BOOGLEY_FRAMES + (long)f * BOOGLEY_FRAME_BYTES;
  display.clearDisplay();
  if (!MIRROR) {
    display.drawBitmap(0, 0, pic, SCREEN_W, SCREEN_H, SSD1306_WHITE);
  } else {
    for (int y = 0; y < SCREEN_H; y++)
      for (int x = 0; x < SCREEN_W; x++)
        if (pgm_read_byte(pic + y * (SCREEN_W / 8) + (x >> 3)) & (0x80 >> (x & 7)))
          display.drawPixel(SCREEN_W - 1 - x, y, SSD1306_WHITE);
  }
  display.display();
}

// Counts the lit pixels in one frame (used once at start-up as a self check).
int litPixels(int f) {
  const uint8_t* pic = BOOGLEY_FRAMES + (long)f * BOOGLEY_FRAME_BYTES;
  int lit = 0;
  for (int i = 0; i < BOOGLEY_FRAME_BYTES; i++) {
    uint8_t b = pgm_read_byte(pic + i);
    while (b) { lit += b & 1; b >>= 1; }
  }
  return lit;
}

// ---------------------------------------------------------------------
// Setup and loop
// ---------------------------------------------------------------------
bool deviceAnswers(int addr) {
  Wire.beginTransmission(addr);
  return Wire.endTransmission() == 0;
}

void oledCommand(uint8_t c) {
  Wire.beginTransmission(foundAddr);
  Wire.write(0x00);
  Wire.write(c);
  Wire.endTransmission();
}

void setup() {
  Serial.begin(115200);
  delay(500);
  Serial.println("\n===== BOOGLEY DANCE =====");

  Wire.begin(SDA_PIN, SCL_PIN, 100000);
  delay(50);
  for (int tries = 0; tries < 20 && foundAddr == 0; tries++) {   // this board often misses the first probe
    if (deviceAnswers(0x3C))      foundAddr = 0x3C;
    else if (deviceAnswers(0x3D)) foundAddr = 0x3D;
    else delay(30);
  }
  if (foundAddr == 0) {
    Serial.println("OLED NOT found on SDA=G25 SCL=G26. Check the 4 wires.");
    while (true) delay(1000);
  }
  Serial.printf("OLED found at 0x%02X\n", foundAddr);

  // Wake-up sequence this panel needs before the driver takes over.
  oledCommand(0xAE);
  oledCommand(0x8D); oledCommand(0x14);
  oledCommand(0xAD); oledCommand(0x8B);
  oledCommand(0xAF);
  delay(100);

  if (!display.begin(SSD1306_SWITCHCAPVCC, foundAddr)) {
    Serial.println("display.begin() failed.");
    while (true) delay(1000);
  }

  Serial.printf("%d frames. Frame 0 has %d pixels lit.\n", BOOGLEY_COUNT, litPixels(0));
  showFrame(0);
  lastFrameAt = millis();
  Serial.println("Ready. The dance is running.");
}

void loop() {
  unsigned long now = millis();
  if (now - lastFrameAt < (unsigned long)(1000 / FRAMES_PER_SECOND)) { delay(2); return; }
  lastFrameAt = now;

  frame += direction;
  if (BOUNCE) {
    if (frame >= BOOGLEY_COUNT) { frame = BOOGLEY_COUNT - 2; direction = -1; }
    else if (frame < 0)         { frame = 1; direction = 1; }
  } else if (frame >= BOOGLEY_COUNT) {
    frame = 0;
    Serial.println("Loop: back to frame 0");
  }
  showFrame(frame);
}

