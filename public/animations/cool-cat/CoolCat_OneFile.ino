// COOL CAT (everything in one file) for an ESP32 + 0.96" OLED (128 x 64, I2C)
// Wiring: OLED VCC -> 3V3, GND -> GND, SDA -> G25, SCL -> G26
//
// The fluffy cat in round sunglasses from cool_cat.html. Its tail lifts, slaps back down and
// rubs along the ground twice, then the cat sits still for a moment and it all starts again.
// Needs the Adafruit SSD1306 and Adafruit GFX libraries (Library Manager).

#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
// The drawings are at the very bottom of this file.
// These lines tell the compiler about them before they are used.
const int CAT_FRAMES = 20;
extern const unsigned char CAT_FILL[CAT_FRAMES][1024];
extern const unsigned char CAT_LINE[CAT_FRAMES][1024];

const int SDA_PIN = 25;
const int SCL_PIN = 26;

const int SCREEN_W = 128;
const int SCREEN_H = 64;

// ----- settings you can change -----
const bool FILL = true;            // true = Fill (the cat looks like the drawing: paper lit, lines dark). false = Line (only the lines lit)
const int FRAME_MS = 83;           // time per drawing of the tail move. 83 is the page's 12 frames a second
const int REST_MS = 830;           // how long the cat sits still between two tail moves

Adafruit_SSD1306 display(SCREEN_W, SCREEN_H, &Wire, -1);
int foundAddr = 0;

const unsigned char (*drawings)[1024] = nullptr;   // CAT_FILL or CAT_LINE, picked in setup()
int frame = 0;
unsigned long lastFrameAt = 0;

// ---------------------------------------------------------------------
// Small helpers
// ---------------------------------------------------------------------
void drawFrame(int f) {
  display.clearDisplay();
  display.drawBitmap(0, 0, drawings[f], SCREEN_W, SCREEN_H, SSD1306_WHITE);
  display.display();
}

// Counts the lit pixels in the first drawing (printed once at start-up as a self check).
int litPixels() {
  int lit = 0;
  for (int i = 0; i < SCREEN_W * SCREEN_H / 8; i++) {
    uint8_t b = pgm_read_byte(&drawings[0][i]);
    while (b) { lit += b & 1; b >>= 1; }
  }
  return lit;
}

// ---------------------------------------------------------------------
// Setup and loop
// ---------------------------------------------------------------------
bool deviceAnswers(int addr) {
  Wire.beginTransmission(addr);
  return Wire.endTransmission() == 0;
}

void oledCommand(uint8_t c) {
  Wire.beginTransmission(foundAddr);
  Wire.write(0x00);
  Wire.write(c);
  Wire.endTransmission();
}

void setup() {
  Serial.begin(115200);
  delay(500);
  Serial.println("\n===== COOL CAT =====");

  Wire.begin(SDA_PIN, SCL_PIN, 100000);
  delay(50);
  for (int tries = 0; tries < 20 && foundAddr == 0; tries++) {   // some boards miss the first probe
    if (deviceAnswers(0x3C))      foundAddr = 0x3C;
    else if (deviceAnswers(0x3D)) foundAddr = 0x3D;
    else delay(30);
  }
  if (foundAddr == 0) {
    Serial.println("OLED NOT found on SDA=G25 SCL=G26. Check the 4 wires.");
    while (true) delay(1000);
  }
  Serial.printf("OLED found at 0x%02X\n", foundAddr);

  // Wake-up sequence some panels need before the driver takes over.
  oledCommand(0xAE);
  oledCommand(0x8D); oledCommand(0x14);
  oledCommand(0xAD); oledCommand(0x8B);
  oledCommand(0xAF);
  delay(100);

  if (!display.begin(SSD1306_SWITCHCAPVCC, foundAddr)) {
    Serial.println("display.begin() failed.");
    while (true) delay(1000);
  }

  drawings = FILL ? CAT_FILL : CAT_LINE;
  Serial.printf("%s style, %d drawings, %d pixels lit\n", FILL ? "Fill" : "Line", CAT_FRAMES, litPixels());

  drawFrame(0);
  lastFrameAt = millis();
  Serial.println("Ready. The tail moves every few seconds.");
}

void loop() {
  unsigned long now = millis();
  // After the last drawing the cat holds the first one for REST_MS, otherwise each drawing gets FRAME_MS.
  unsigned long wait = (frame == 0) ? REST_MS : FRAME_MS;
  if (now - lastFrameAt < wait) { delay(2); return; }
  lastFrameAt = now;

  frame = (frame + 1) % CAT_FRAMES;
  drawFrame(frame);
}

